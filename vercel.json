{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/catalog.js": {
      "includeFiles": [
        "private/releases/**",
        "private/production_state/**"
      ]
    },
    "api/create-order.js": {
      "includeFiles": [
        "private/releases/**",
        "private/production_state/**"
      ]
    },
    "api/verify-payment.js": {
      "includeFiles": [
        "private/releases/**",
        "private/production_state/**"
      ]
    },
    "api/download.js": {
      "includeFiles": [
        "private/releases/**",
        "private/production_state/**"
      ]
    }
  }
}
